# Vite environment variables
# Create a .env.local file and copy these variables with your actual values

# Public environment variables (accessible in the browser)
# Must be prefixed with VITE_

# App mode: STAGING (uses Blockpot Testnet) or anything else (uses Hardhat)
VITE_APP_MODE=DEVELOPMENT

VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Hosted Blockpot Testnet (chain-id 69696). Required when VITE_APP_MODE=STAGING.
# In Railway-driven builds, both values come from the project-scoped CHAINS_CONFIG
# shared variable (the testnet-deployer service emits the JSON; the consumer's
# build step extracts the matching entry into these two VITE_TESTNET_* vars).
VITE_TESTNET_RPC_URL=https://testnet-chain.up.railway.app
VITE_TESTNET_CHAIN_ID=69696

# Optional override for the Ethereum mainnet RPC used by ENS lookups in the
# wallet pill. Defaults to viem's built-in (eth.merkle.io) when unset, which
# can hit CORS issues from browser origins. Set to a CORS-friendly endpoint
# (e.g. https://cloudflare-eth.com) to avoid those.
VITE_MAINNET_RPC_URL=

# Bypass country detection in development (TRUE | FALSE)
VITE_MOCK_COUNTRY=FALSE

# BlockPot gaming service (operator automation backend) — used by the
# PlayerRegistrationBanner to submit SIWE-proven register requests. Required
# for wallet registration to work; unset it and the Register-wallet CTA stays
# disabled.
VITE_GAMING_SERVICE_URL=http://localhost:8080

# Testnet ETH faucet footer link. Set to "true" only on the hosted Blockpot
# testnet (chain-id 69696). The link calls the gaming-service at
# POST /v1/faucet/request, which relays a 1-ETH dispense to the connected
# player's wallet. Defaults off; never enable on production.
VITE_ENABLE_TESTNET_FAUCET=false
